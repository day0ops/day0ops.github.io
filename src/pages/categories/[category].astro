---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import PostRow from '../../components/PostRow.astro';
import { categories, type CategoryKey } from '../../config/categories';

export async function getStaticPaths() {
  return Object.keys(categories).map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const categoryData = categories[category as CategoryKey];

if (!categoryData) {
  return Astro.redirect('/404');
}

const allPosts = await getCollection('blog', (p) => !p.data.draft);

// Filter posts that have any of the category's tags
const posts = allPosts
  .filter((p) => p.data.tags.some((t) => categoryData.tags.some((tag) => tag === t.toLowerCase())))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Build nav tag list
const tagCounts: Record<string, number> = {};
allPosts.forEach((p) =>
  p.data.tags.forEach((t) => {
    tagCounts[t] = (tagCounts[t] ?? 0) + 1;
  }),
);
const allTags = Object.entries(tagCounts)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([tag, count]) => ({ tag, count }));
---

<BlogPost title={categoryData.title} description={categoryData.description} tags={allTags}>
  <main class="category-main">
    <div class="category-content">
      <div class={`category-header category-header--${categoryData.color}`}>
        <h1 class="category-title">{categoryData.title}</h1>
        <p class="category-subtitle">{categoryData.subtitle}</p>
      </div>
      <p class="category-desc">{categoryData.description}</p>
      <p class="category-count">
        {posts.length} post{posts.length !== 1 ? 's' : ''}
      </p>
      {posts.length === 0 ? (
        <p class="empty-state">No posts yet.</p>
      ) : (
        <div class="post-list">
          {posts.map((post) => (
            <PostRow post={post} />
          ))}
        </div>
      )}
    </div>
  </main>
</BlogPost>

<style>
  .category-main {
    padding: 2rem 1.5rem;
  }
  .category-content {
    max-width: 680px;
  }

  .category-header {
    margin-bottom: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid;
  }
  .category-header--primary {
    border-color: var(--color-primary);
  }
  .category-header--oops {
    border-color: var(--color-oops);
  }
  .category-header--warn {
    border-color: var(--color-warn);
  }
  .category-header--success {
    border-color: var(--color-success);
  }

  .category-title {
    font-size: 1.75rem;
    letter-spacing: -0.025em;
    color: var(--color-text-hi);
    margin-bottom: 0.125rem;
  }
  .category-header--primary .category-title {
    color: var(--color-primary);
  }
  .category-header--oops .category-title {
    color: var(--color-oops);
  }
  .category-header--warn .category-title {
    color: var(--color-warn);
  }
  .category-header--success .category-title {
    color: var(--color-success);
  }

  .category-subtitle {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }

  .category-desc {
    font-size: 0.9375rem;
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .category-count {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }

  .empty-state {
    color: var(--color-muted);
    font-style: italic;
  }
</style>
