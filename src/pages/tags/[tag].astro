---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import PostRow from '../../components/PostRow.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  const tagSet = new Set(posts.flatMap((p) => p.data.tags));
  return Array.from(tagSet).map((tagName) => ({
    params: { tag: tagName },
    props: {
      tag: tagName,
      posts: posts
        .filter((p) => p.data.tags.includes(tagName))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;

// Build nav tag list
const allPosts = await getCollection('blog', (p) => !p.data.draft);
const tagCounts: Record<string, number> = {};
allPosts.forEach((p) =>
  p.data.tags.forEach((t) => {
    tagCounts[t] = (tagCounts[t] ?? 0) + 1;
  }),
);
const allTags = Object.entries(tagCounts)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([tag, count]) => ({ tag, count }));
---

<BlogPost title={`#${tag}`} description={`Posts tagged #${tag} on day0ops`} tags={allTags}>
  <main class="tag-main">
    <div class="tag-content">
      <h1 class="tag-heading">#{tag}</h1>
      <p class="tag-count-label">
        {posts.length} post{posts.length !== 1 ? 's' : ''}
      </p>
      {posts.length === 0 ? (
        <p class="empty-state">No posts yet.</p>
      ) : (
        <div class="post-list">
          {posts.map((post) => (
            <PostRow post={post} />
          ))}
        </div>
      )}
    </div>
  </main>
</BlogPost>

<style>
  .tag-main {
    padding: 2rem 1.5rem;
  }
  .tag-content {
    max-width: 680px;
  }
  .tag-heading {
    font-size: 1.75rem;
    letter-spacing: -0.025em;
    color: var(--color-text-hi);
    margin-bottom: 0.25rem;
  }
  .tag-count-label {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }
  .empty-state {
    color: var(--color-muted);
    font-style: italic;
  }
</style>
