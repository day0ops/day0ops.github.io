---
interface Props {
  posts: Array<{ title: string; href: string; date: string; tags: string[] }>;
}
const { posts } = Astro.props;
---

<div
  class="search-overlay"
  id="search-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Search posts"
  hidden
>
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-panel">
    <div class="search-input-wrap">
      <svg
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="currentColor"
        class="search-icon"
        aria-hidden="true"
      >
        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
      </svg>
      <input
        type="search"
        class="search-input"
        id="search-input"
        placeholder="Search posts…"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search-esc-hint">ESC</kbd>
    </div>
    <div class="search-results" id="search-results" role="list">
      <div class="search-hint">Start typing to search…</div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ posts }}>
  var modal = document.getElementById('search-modal');
  var backdrop = document.getElementById('search-backdrop');
  var input = document.getElementById('search-input');
  var results = document.getElementById('search-results');

  function openModal() {
    modal.hidden = false;
    setTimeout(function () {
      input.focus();
    }, 30);
  }
  function closeModal() {
    modal.hidden = true;
    input.value = '';
    results.innerHTML = '<div class="search-hint">Start typing to search\u2026</div>';
  }
  function renderResults(query) {
    var q = query.trim().toLowerCase();
    if (!q) {
      results.innerHTML = '<div class="search-hint">Start typing to search\u2026</div>';
      return;
    }
    var matches = posts.filter(function (p) {
      return (
        p.title.toLowerCase().includes(q) ||
        p.tags.some(function (t) {
          return t.toLowerCase().includes(q);
        })
      );
    });
    if (!matches.length) {
      var hint = document.createElement('div');
      hint.className = 'search-hint';
      hint.textContent = 'No posts found for “' + query + '”';
      results.replaceChildren(hint);
      return;
    }
    results.innerHTML = matches
      .map(function (p) {
        return (
          '<a href="' +
          p.href +
          '" class="search-result-item" role="listitem">' +
          '<span class="sr-title">' +
          p.title +
          '</span>' +
          '<span class="sr-meta">' +
          p.date +
          (p.tags.length ? ' &middot; ' + p.tags.slice(0, 3).join(', ') : '') +
          '</span>' +
          '</a>'
        );
      })
      .join('');
    results.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closeModal);
    });
  }

  document.addEventListener('day0ops:search-open', openModal);
  if (backdrop) backdrop.addEventListener('click', closeModal);
  if (input)
    input.addEventListener('input', function () {
      renderResults(input.value);
    });
  document.addEventListener('keydown', function (e) {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openModal();
    }
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });
</script>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    background: rgba(8, 15, 31, 0.75);
    backdrop-filter: blur(4px);
  }
  .search-overlay[hidden] {
    display: none;
  }
  .search-backdrop {
    position: absolute;
    inset: 0;
  }
  .search-panel {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: 0 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
  }
  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .search-icon {
    color: var(--color-muted);
    flex-shrink: 0;
  }
  .search-input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    color: var(--color-text-hi);
    font-size: 0.9375rem;
    font-family: inherit;
    caret-color: var(--color-primary);
  }
  .search-input::placeholder {
    color: var(--color-muted);
  }
  .search-esc-hint {
    font-size: 10px;
    font-family: 'Geist Mono', monospace;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 1px 5px;
    opacity: 0.7;
  }
  .search-results {
    max-height: 360px;
    overflow-y: auto;
  }
  /* Results inserted by the inline script do not receive Astro's scope attribute. */
  .search-results :global(.search-hint) {
    padding: 1.25rem 1rem;
    font-size: 0.875rem;
    color: var(--color-muted);
    text-align: center;
    overflow-wrap: anywhere;
  }
  .search-results :global(.search-result-item) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-wrap: anywhere;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: background 0.1s;
  }
  .search-results :global(.search-result-item:last-child) {
    border-bottom: none;
  }
  .search-results :global(.search-result-item:hover),
  .search-results :global(.search-result-item:focus-visible) {
    background: var(--color-bg);
    text-decoration: none;
  }
  .search-results :global(.sr-title) {
    font-size: 0.875rem;
    color: var(--color-text-hi);
    font-weight: 500;
  }
  .search-results :global(.sr-meta) {
    font-size: 0.75rem;
    color: var(--color-muted);
    font-family: 'Geist Mono', monospace;
  }
</style>
