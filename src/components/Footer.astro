<style>
  .site-footer {
    padding: 1.5rem 28px;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: center;
  }
  .social-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
  }
  .social-link {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--color-muted);
    text-decoration: none;
    font-size: 11px;
    padding: 3px 6px;
    border-radius: 4px;
    transition: color 0.15s;
  }
  .social-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }
  .social-link svg {
    flex-shrink: 0;
  }
  .footer-text {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    font-size: 10px;
    color: var(--color-muted);
  }
  .footer-text a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-text a:hover {
    color: var(--color-primary);
  }
  .sep {
    color: var(--color-border);
    padding: 0 5px;
    user-select: none;
  }
  .heart {
    color: var(--color-oops);
  }
</style>
