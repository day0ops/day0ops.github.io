---
// Sticky topbar: search pill + theme toggle
// Search pill dispatches day0ops:search-open
// Theme toggle sets data-theme on <html> and persists to localStorage
---

<div class="topbar" id="topbar">
  <button class="search-pill" id="topbar-search" aria-label="Search posts">
    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
    </svg>
    <span class="search-pill-text">Search posts…</span>
    <kbd>⌘K</kbd>
  </button>

  <button class="theme-btn" id="theme-btn" aria-label="Switch to light theme">
    <!-- Moon: shown in dark mode -->
    <span class="moon-icon" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
        <path d="M6 .278a.77.77 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z" />
      </svg>
    </span>
    <!-- Sun: shown in light mode -->
    <span class="sun-icon" aria-hidden="true" hidden>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0zm0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13zm8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5zM3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8zm10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0zm-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 1 1 .707.707zm9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707zM4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707z" />
      </svg>
    </span>
  </button>
</div>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 5px 28px;
    gap: 20px;
  }

  .search-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 6px 12px;
    color: var(--color-muted);
    font-size: 12px;
    width: 220px;
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .search-pill:hover {
    border-color: var(--color-primary);
    color: var(--color-text-hi);
  }

  .search-pill kbd {
    margin-left: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 1px 5px;
    font-size: 10px;
    font-family: inherit;
    color: var(--color-muted);
    pointer-events: none;
  }

  .theme-btn {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-muted);
    width: 36px;
    height: 36px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      color 0.15s,
      border-color 0.15s;
    flex-shrink: 0;
  }
  .theme-btn:hover {
    color: var(--color-text-hi);
    border-color: var(--color-primary);
  }

  .moon-icon,
  .sun-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .moon-icon[hidden],
  .sun-icon[hidden] {
    display: none;
  }

  @media (max-width: 767px) {
    .topbar {
      padding: 5px 16px;
      top: 52px;
    }
    .search-pill {
      width: auto;
      flex: 1;
    }
    .search-pill-text {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var THEME_KEY = 'day0ops-theme';
    var html = document.documentElement;

    function getEffectiveTheme() {
      var saved = localStorage.getItem(THEME_KEY);
      if (saved) return saved;
      return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }

    function applyTheme(theme) {
      html.setAttribute('data-theme', theme);
      var btn = document.getElementById('theme-btn');
      if (!btn) return;
      var moon = btn.querySelector('.moon-icon');
      var sun = btn.querySelector('.sun-icon');
      if (moon) moon.hidden = theme === 'light';
      if (sun) sun.hidden = theme === 'dark';
      btn.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
      );
    }

    applyTheme(getEffectiveTheme());

    var btn = document.getElementById('theme-btn');
    if (btn) {
      btn.addEventListener('click', function () {
        var next = getEffectiveTheme() === 'light' ? 'dark' : 'light';
        localStorage.setItem(THEME_KEY, next);
        applyTheme(next);
      });
    }

    var searchBtn = document.getElementById('topbar-search');
    if (searchBtn) {
      searchBtn.addEventListener('click', function () {
        document.dispatchEvent(new CustomEvent('day0ops:search-open'));
      });
    }
  })();
</script>
