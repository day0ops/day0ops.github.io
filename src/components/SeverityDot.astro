---
interface Props {
  severity: 'primary' | 'warn' | 'oops';
}
const { severity } = Astro.props;
---

<span class={`severity-dot severity-dot--${severity}`} aria-hidden="true"></span>

<style>
  .severity-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    align-self: center;
  }
  .severity-dot--primary {
    background: var(--color-primary);
  }
  .severity-dot--warn {
    background: var(--color-warn);
  }
  .severity-dot--oops {
    background: var(--color-oops);
  }
</style>
