---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;

// Only h2 and h3
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filtered.length > 0 && (
  <nav class="toc" aria-label="Table of contents">
    <p class="toc-label">On this page</p>
    <ul role="list">
      {filtered.map((h) => (
        <li class={`toc-item toc-item--depth-${h.depth}`}>
          <a href={`#${h.slug}`} class="toc-link">
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    position: sticky;
    top: 5rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-border);
    font-size: 0.75rem;
  }

  .toc-label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .toc ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .toc-item--depth-3 {
    padding-left: 0.75rem;
  }

  .toc-link {
    color: var(--color-text-body);
    text-decoration: none;
    display: block;
    padding: 0.15rem 0.25rem;
    border-radius: 3px;
    transition: color 0.15s;
  }
  .toc-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }
  .toc-link.active {
    color: var(--color-primary);
    border-left: 2px solid var(--color-primary);
    padding-left: calc(0.25rem - 2px);
  }
</style>

<script is:inline>
  (function () {
    const links = document.querySelectorAll('.toc-link');
    if (!links.length) return;

    const headingIds = Array.from(links).map((l) => l.getAttribute('href').slice(1));
    const headingEls = headingIds.map((id) => document.getElementById(id)).filter(Boolean);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.getAttribute('id');
          const link = document.querySelector(`.toc-link[href="#${id}"]`);
          if (link) link.classList.toggle('active', entry.isIntersecting);
        });
      },
      { rootMargin: '0px 0px -60% 0px', threshold: 0 },
    );

    headingEls.forEach((el) => observer.observe(el));
  })();
</script>
